# PostgreSQL connection string (Supabase, Neon, Railway, or any Postgres host)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Secret used to sign JWT auth tokens - use any long random string
JWT_SECRET=replace-with-a-long-random-string

# Number of days a complaint can stay Open/In Progress before it is flagged overdue
OVERDUE_THRESHOLD_DAYS=5

# Cloudinary (unsigned upload) - used for complaint photo uploads
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset

# Resend (email) - https://resend.com - free tier
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=onboarding@resend.dev
